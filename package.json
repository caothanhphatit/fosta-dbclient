    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tauri-apps/cli": "^2.5.0",
    "eslint": "9.39.4",
    "prettier": "3.9.6",
    "typescript": "^5.8.0",
    "typescript-eslint": "8.66.0",
    "vite": "^6.3.0",
    "vitest": "4.1.12"
  }
